{% if site.data.socials.email %}
  <a href="mailto:{{ site.data.socials.email | encode_email }}" title="email"><i class="fa-solid fa-envelope"></i></a>
{% endif %}
{% if site.data.socials.telegram_username %}
  <a href="https://telegram.me/{{ site.data.socials.telegram_username }}" title="telegram"><i class="fa-brands fa-telegram"></i></a>
{% endif %}
{% if site.data.socials.whatsapp_number %}
  <a href="https://wa.me/{{ site.data.socials.whatsapp_number }}" title="whatsapp"><i class="fa-brands fa-whatsapp"></i></a>
{% endif %}
{% if site.data.socials.orcid_id %}
  <a href="https://orcid.org/{{ site.data.socials.orcid_id }}" title="ORCID"><i class="ai ai-orcid"></i></a>
{% endif %}
{% if site.data.socials.scholar_userid %}
  <a href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}" title="Google Scholar"><i class="ai ai-google-scholar"></i></a>
{% endif %}
{% if site.data.socials.inspirehep_id %}
